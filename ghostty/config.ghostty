# Config generated by Ghostty Config

clipboard-read = allow
theme = light:Atom One Light,dark:Atom One Dark
# Toggled by ~/.local/bin/ghostty-toggle-theme (cmd+shift+L)
window-theme = dark
keybind = shift+super+arrow_right=next_tab
keybind = shift+super+arrow_left=previous_tab

# Auto-equalize splits when creating new ones
keybind = super+d=new_split:right
keybind = chain=equalize_splits
keybind = super+shift+d=new_split:down
keybind = chain=equalize_splits
keybind = super+ctrl+e=equalize_splits
